Cell[BoxData[
 RowBox[{
  RowBox[{"T1a1", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0", "0", "0"},
      {"0", 
       RowBox[{"Cos", "[", "\[Theta]1", "]"}], 
       RowBox[{"-", 
        RowBox[{"Sin", "[", "\[Theta]1", "]"}]}], "0"},
      {"0", 
       RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
       RowBox[{"Cos", "[", "\[Theta]1", "]"}], "L0"},
      {"0", "0", "0", "1"}
     }], ")"}]}], ";"}]], "Input",
